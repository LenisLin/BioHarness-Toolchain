{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BackendAdapterSpec v0.7.1",
  "description": "Blueprint-level Layer 4 adapter, wrapper, or rewrite binding schema aligned with MethodExecutionPlanningRecord v0.7.1. This schema is permissive for planning drafts and does not imply runtime support.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "backend_adapter_id",
    "linked_surface_id",
    "backend_method",
    "authority_status",
    "implementation_status",
    "evidence_authority",
    "runtime_language",
    "integration_mode",
    "backend_entrypoints",
    "function_surface_bindings",
    "parameter_mapping",
    "input_conversion",
    "output_mapping",
    "artifact_mapping",
    "filesystem_policy",
    "failure_translation",
    "environment_binding",
    "smoke_test",
    "fidelity_test",
    "rewrite_level",
    "visibility",
    "authority_note"
  ],
  "properties": {
    "backend_adapter_id": {
      "type": "string"
    },
    "linked_surface_id": {
      "type": "string"
    },
    "backend_method": {
      "type": "string"
    },
    "authority_status": {
      "type": "string"
    },
    "implementation_status": {
      "type": "string"
    },
    "native_repository": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_authority": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_resolution": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "level": {
          "enum": [
            "file_level",
            "symbol_level",
            "line_level",
            "runtime_observed"
          ]
        },
        "implementation_ready": {
          "type": "boolean"
        }
      }
    },
    "runtime_language": {
      "type": "string"
    },
    "environment_profile_candidate": {
      "type": "string"
    },
    "integration_mode": {
      "type": [
        "string",
        "object"
      ],
      "additionalProperties": true
    },
    "backend_entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "implementation_blocker": {
            "type": "boolean"
          },
          "resolution_required_before": {
            "type": "string"
          }
        }
      }
    },
    "function_surface_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "layer3_stage": {
            "type": "string"
          },
          "binding_status": {
            "enum": [
              "backend_bound",
              "wrapper_added",
              "not_applicable",
              "requires_followup"
            ]
          },
          "backend_files_or_functions": {
            "type": "array"
          },
          "adapter_responsibility": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array"
          },
          "implementation_blocker": {
            "type": "boolean"
          },
          "resolution_required_before": {
            "type": "string"
          }
        }
      }
    },
    "parameter_mapping": {
      "type": [
        "object",
        "array"
      ]
    },
    "input_conversion": {
      "type": [
        "object",
        "array"
      ]
    },
    "output_mapping": {
      "type": [
        "object",
        "array"
      ]
    },
    "artifact_mapping": {
      "type": [
        "object",
        "array"
      ]
    },
    "filesystem_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "failure_translation": {
      "type": [
        "object",
        "array"
      ]
    },
    "environment_binding": {
      "type": "object",
      "additionalProperties": true
    },
    "smoke_test": {
      "type": "object",
      "additionalProperties": true
    },
    "fidelity_test": {
      "type": "object",
      "additionalProperties": true
    },
    "rewrite_level": {
      "type": "string"
    },
    "rewrite_rationale": {
      "type": "string"
    },
    "algorithm_core_touched": {
      "type": "boolean"
    },
    "visibility": {
      "type": "string"
    },
    "implementation_blocker": {
      "type": "boolean"
    },
    "resolution_required_before": {
      "type": "string"
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "example_status": {
      "type": "string"
    },
    "authority_note": {
      "type": "string"
    }
  }
}
