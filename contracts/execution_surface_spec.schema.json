{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionSurfaceSpec",
  "type": "object",
  "required": [
    "surface_id",
    "analysis_problem",
    "input_contract",
    "parameter_template",
    "environment_profile",
    "output_artifacts",
    "validation_hooks"
  ],
  "properties": {
    "surface_id": {
      "type": "string"
    },
    "inherits_from": {
      "type": "string"
    },
    "analysis_problem": {
      "type": "string"
    },
    "task_family": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "visibility": {
      "type": "string"
    },
    "authority_status": {
      "type": "string"
    },
    "surface_status": {
      "type": "string"
    },
    "functional_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_contract": {
      "type": "object"
    },
    "parameter_template": {
      "type": "object"
    },
    "environment_profile": {
      "type": "string"
    },
    "output_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_hooks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "semantic_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "semantic_parameters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "semantic_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "spatial_coordinate_source": {
      "type": "object",
      "additionalProperties": true
    },
    "multi_sample_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "target_domain_count_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "parameter_policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "expose_to_agent_with_constraints": {
          "type": [
            "array",
            "object",
            "null"
          ]
        },
        "forbidden_for_agent": {
          "type": [
            "array",
            "object",
            "null"
          ]
        },
        "fixed_by_adapter": {
          "type": [
            "array",
            "object",
            "null"
          ]
        }
      }
    },
    "clustering_backend_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "layer4_reference_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "validation_contract": {
      "type": "object",
      "additionalProperties": true
    },
    "failure_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "preflight_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "postrun_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance_expectations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "backend_adapter": {
      "type": "string"
    },
    "example_status": {
      "type": "string"
    },
    "authority_note": {
      "type": "string"
    },
    "failure_semantics": {
      "type": "object"
    }
  }
}
